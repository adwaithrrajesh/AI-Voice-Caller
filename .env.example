# Copy this file to `.env` and fill in your real keys.

# ---------------------------------------------------------------------------
# Sarvam AI — STT (Saarika), LLM (Sarvam-30B), TTS (Bulbul)
# Get this from https://dashboard.sarvam.ai
# ---------------------------------------------------------------------------
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# LiveKit Cloud — required for `python agent.py start` and make_call.py
# Create a project at https://cloud.livekit.io
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Name the dispatcher targets. Must match the agent_name registered in
# agent.py (defaults to "sales-agent" on both sides — leave it).
AGENT_NAME=sales-agent

# ---------------------------------------------------------------------------
# LiveKit ⇄ Vobiz outbound SIP trunk
# After running `lk sip outbound create outbound_trunk.json`, paste the
# returned SIPTrunkID here.
# ---------------------------------------------------------------------------
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Vobiz credentials — used ONLY when filling outbound_trunk.json before
# the one-time `lk sip outbound create`. They are not read at runtime.
# Get them from the Vobiz dashboard -> Trunks -> Outbound -> Authentication.
# ---------------------------------------------------------------------------
VOBIZ_SIP_DOMAIN=your-unique-domain.sip.vobiz.ai
VOBIZ_USERNAME=vobiz_username
VOBIZ_PASSWORD=vobiz_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

# ---------------------------------------------------------------------------
# Optional defaults
# ---------------------------------------------------------------------------
# Used in console mode (no telephony) for the opening line.
PROSPECT_NAME=Krish

# ---------------------------------------------------------------------------
# Voice tuning — A/B without code changes
# ---------------------------------------------------------------------------
# Bulbul v3 male voices for clear/crisp Indian English (default lang_hint=en-IN):
#   shubh    - Customer Care, crispest articulation (default for English)
#   ratan    - Customer Care, slightly deeper
#   rohan    - Customer Care, neutral male
#   aditya   - Content Creation, warmer/conversational
#   kabir    - Content Creation, deeper timbre
TTS_SPEAKER=shubh

# Digital gain on TTS output. 1.0 = no change. 2.0 ≈ +6 dB (default,
# perceived ~2x louder). 2.5 ≈ +8 dB. 3.0 ≈ +9.5 dB (max before clipping).
TTS_GAIN=2.0
